# ==============================================================================
# Developer Activity Tracker - Environment Configuration
# ==============================================================================

# FerretDB Connection URI (MongoDB wire protocol compatible)
# Connect to your running FerretDB instance (default port 27017)
FERRETDB_URI=mongodb://127.0.0.1:27017/
FERRETDB_DB_NAME=developer_tracker
FERRETDB_COLLECTION_NAME=activities

# Redis Connection URL
# Redis server is used for caching activities and dashboard statistics
REDIS_URL=redis://127.0.0.1:6379/0

# Cache Expiration Time in seconds (default: 60)
CACHE_TTL=60

# Flask Server Settings
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=True
